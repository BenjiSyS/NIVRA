# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Node / web
node_modules/
web/dist/
internal/webui/dist/*
!internal/webui/dist/.keep

# Go / build output
/bin/
/dist/
*.exe
*.test
coverage.out

# Runtime data, secrets and local config (never commit)
/data/
/runs/
/NivraData/
.env
*.key
*.pem
secrets/
# ...but the Go package that manages them is source code.
!internal/controller/secrets/
worker-identity.json
controller-secrets.json

# Model weights and generated media belong in artifact storage, not git
*.safetensors
*.pt
*.ckpt
*.mp4
*.npz

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
/logs/

# transcribe/: only the tool itself is tracked, never videos or captions
/transcribe/*
!/transcribe/transcribe.py
!/transcribe/Transcribe.bat
!/transcribe/README.md
