{
  "name": "nivra_hd_tiny",
  "arch_version": "nivra-hd/1",
  "domain": "stylized",
  "styles": ["anime", "3d animation", "cartoon", "2d animation", "cel-shaded 3d", "pixel art", "claymation",
             "painterly", "realistic"],
  "default_style": "anime",
  "vae": {"latent_channels": 8, "channels": [8, 8, 16, 16, 16, 16], "temporal_down": [1, 2, 3],
          "n_res": 1, "n_res_dec": 1, "edge_weight": 0.5},
  "model": {"dim": 32, "depth": 2, "heads": 2, "mlp_ratio": 2.0, "patch": [1, 1, 1], "text_dim": 16,
            "qk_norm": true},
  "inference": {"width": 96, "height": 64, "seconds": 0.53, "fps": 30, "steps": 4, "cfg_scale": 3.0,
                "sampler": "ab2", "shift_base_tokens": 16, "fp16": true, "int8": false, "offload": false,
                "attn_chunk": 0, "mlp_chunk": 0, "vae_t_chunk": 1, "vae_tile": 0, "vae_overlap": 1,
                "vae_margin": null},
  "train": {
    "stages": [
      {"name": "s0_img", "height": 32, "width": 64, "frames": 1, "steps": 2},
      {"name": "s1_32p", "height": 32, "width": 64, "frames": 9, "steps": 3, "image_fraction": 0.25},
      {"name": "s2_64p", "height": 64, "width": 64, "frames": 17, "steps": 3, "image_fraction": 0.25}
    ],
    "vae_stages": [
      {"name": "ae_img", "height": 32, "width": 64, "frames": 1, "steps": 2},
      {"name": "ae_clips_lowres", "height": 32, "width": 64, "frames": 9, "steps": 3, "image_fraction": 0.25},
      {"name": "ae_target", "height": 64, "width": 64, "frames": 17, "steps": 3, "image_fraction": 0.25}
    ],
    "batch_size": 2, "grad_accum": 1, "lr": 3e-3, "weight_decay": 0.0, "warmup": 2, "grad_clip": 1.0,
    "optimizer": "adamw", "grad_checkpoint": true, "fp16": true, "caption_dropout": 0.1, "style_dropout": 0.1,
    "shift_base_tokens": 16, "vae_lr": 2e-3, "vae_kl_weight": 1e-6, "vae_perc_weight": 0.5,
    "vae_tdiff_weight": 0.5, "save_every": 4, "keep_last": 3,
    "vae_gan_weight": 0.05, "vae_gan_start": 4, "vae_gan_lr": 1e-3, "vae_gan_base": 8, "vae_gan_layers": 2,
    "vae_latent_norm": "channel",
    "ema_decay": 0.99, "ema_warmup": true,
    "sra": {"weight": 0.5, "student_layer": 0, "teacher_layer": 1, "t_ratio": 0.5, "until_step": 0},
    "diffusion_forcing": {"fraction": 0.25, "cond_fraction": 0.0},
    "fp32_attn": true
  }
}
