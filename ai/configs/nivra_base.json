{
  "name": "nivra_base",
  "arch_version": "nivra-hd/1",
  "domain": "stylized",
  "styles": ["anime", "3d animation", "cartoon", "2d animation", "cel-shaded 3d", "pixel art", "claymation",
             "painterly", "realistic"],
  "default_style": "anime",
  "vae": {"latent_channels": 64, "channels": [32, 64, 128, 256, 256, 512], "temporal_down": [1, 2, 3],
          "n_res": 1, "n_res_dec": 1, "edge_weight": 0.5},
  "model": {"dim": 1024, "depth": 12, "heads": 16, "mlp_ratio": 4.0, "patch": [1, 1, 1], "text_dim": 256,
            "qk_norm": true},
  "inference": {"width": 448, "height": 256, "seconds": 2, "fps": 8, "steps": 30, "cfg_scale": 5.0,
                "sampler": "ab2", "shift_base_tokens": 336, "fp16": true, "int8": false, "offload": false,
                "attn_chunk": 0, "mlp_chunk": 0, "vae_t_chunk": 1, "vae_tile": 0, "vae_overlap": 2,
                "vae_margin": null},
  "train": {
    "stages": [
      {"name": "128p_2s", "height": 128, "width": 224, "frames": 17, "steps": 30000},
      {"name": "256p_2s", "height": 256, "width": 448, "frames": 17, "steps": 50000},
      {"name": "256p_4s", "height": 256, "width": 448, "frames": 33, "steps": 20000}
    ],
    "batch_size": 2, "grad_accum": 4, "lr": 1e-4, "weight_decay": 0.0, "warmup": 500, "grad_clip": 1.0,
    "optimizer": "adamw8", "grad_checkpoint": true, "fp16": true, "caption_dropout": 0.1, "style_dropout": 0.1,
    "shift_base_tokens": 336, "vae_lr": 1e-4, "vae_kl_weight": 1e-6, "vae_perc_weight": 0.5,
    "vae_tdiff_weight": 0.5, "save_every": 1000, "keep_last": 3
  }
}
