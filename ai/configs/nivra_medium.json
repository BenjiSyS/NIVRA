{
  "name": "nivra_medium",
  "arch_version": "nivra-hd/1",
  "domain": "stylized",
  "styles": ["anime", "3d animation", "cartoon", "2d animation", "cel-shaded 3d", "pixel art", "claymation",
             "painterly", "realistic"],
  "default_style": "anime",
  "vae": {"latent_channels": 128, "channels": [64, 128, 256, 256, 512, 512], "temporal_down": [1, 2, 3],
          "n_res": 2, "n_res_dec": 2, "edge_weight": 0.5},
  "model": {"dim": 1536, "depth": 24, "heads": 24, "mlp_ratio": 4.0, "patch": [1, 1, 1], "text_dim": 768,
            "qk_norm": true},
  "inference": {"width": 1280, "height": 720, "seconds": 8, "fps": 30, "steps": 30, "cfg_scale": 5.0,
                "sampler": "ab2", "shift_base_tokens": 4096, "fp16": true, "int8": false, "offload": false,
                "attn_chunk": 0, "mlp_chunk": 8192, "vae_t_chunk": 1, "vae_tile": 24, "vae_overlap": 2,
                "vae_margin": null},
  "train": {
    "vae_stages": [
      {"name": "ae_image_256p", "height": 256, "width": 448, "frames": 1, "steps": 30000},
      {"name": "ae_clips_256p", "height": 256, "width": 448, "frames": 17, "steps": 40000, "image_fraction": 0.2},
      {"name": "ae_target_480p", "height": 480, "width": 832, "frames": 33, "steps": 30000, "image_fraction": 0.2}
    ],
    "stages": [
      {"name": "img_256p", "height": 256, "width": 448, "frames": 1, "steps": 50000},
      {"name": "256p_2s", "height": 256, "width": 448, "frames": 65, "steps": 200000, "image_fraction": 0.1},
      {"name": "480p_4s", "height": 480, "width": 832, "frames": 121, "steps": 100000, "image_fraction": 0.05},
      {"name": "720p_8s", "height": 736, "width": 1280, "frames": 241, "steps": 50000}
    ],
    "batch_size": 1, "grad_accum": 8, "lr": 1e-4, "weight_decay": 0.0, "warmup": 1000, "grad_clip": 1.0,
    "optimizer": "adamw8", "grad_checkpoint": true, "fp16": true, "caption_dropout": 0.1, "style_dropout": 0.1,
    "shift_base_tokens": 4096, "vae_lr": 1e-4, "vae_kl_weight": 1e-6, "vae_perc_weight": 0.5,
    "vae_tdiff_weight": 0.5, "save_every": 1000, "keep_last": 3,
    "vae_gan_weight": 0.05, "vae_gan_start": 60000, "vae_gan_lr": 1e-4, "vae_gan_base": 48, "vae_gan_layers": 3,
    "vae_latent_norm": "channel",
    "ema_decay": 0.9999, "ema_warmup": true,
    "sra": {"weight": 0.5, "student_layer": 5, "teacher_layer": 15, "t_ratio": 0.5, "until_step": 150000},
    "diffusion_forcing": {"fraction": 0.25, "cond_fraction": 0.0},
    "fp32_attn": true
  }
}
